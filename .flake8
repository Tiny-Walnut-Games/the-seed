[flake8]
max-line-length = 100
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    .mypy_cache,
    .pytest_cache,
    .ruff_cache,
    Assets,
    packages/com.twg.the-seed/The Living Dev Agent/data/conservator_backups
per-file-ignores =
    __init__.py:F401
